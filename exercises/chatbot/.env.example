# OpenRouter API Key - NUNCA commitear este archivo
# Obtén tu API key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# OpenRouter Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo LLM a utilizar (usa modelos gratuitos)
# Opciones: meta-llama/llama-3.2-3b-instruct:free, google/gemma-2-9b-it:free
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
