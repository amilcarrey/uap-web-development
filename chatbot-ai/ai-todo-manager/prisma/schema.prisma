// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Use the standard JS client generator (default output into `node_modules/@prisma/client`).
generator client {
  provider = "prisma-client-js"
  // Place generated runtime files under @prisma/client so the package's
  // internal `require('.prisma/client/...')` resolves correctly in Node.
  output = "../node_modules/@prisma/client/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Priority {
  low
  medium
  high
}

enum Category {
  work
  personal
  shopping
  health
  other
}

model Task {
  id        String    @id @default(uuid())
  title     String
  priority  Priority  @default(medium)
  category  Category  @default(other)
  dueDate   DateTime?
  completed Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String?

  @@index([priority])
  @@index([category])
  @@index([dueDate])
}
